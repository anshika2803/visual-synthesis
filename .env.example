# Optional environment variables. Copy to `.env` (gitignored) and fill in.
#
#   API_KEY          bearer token required by the HTTP API (unset = no auth)
#   HF_TOKEN         HuggingFace token, for gated repos
#   HF_HOME          HuggingFace cache location
#
# Config overrides (applied on top of the config files, below CLI flags):
#   VS_LOG_LEVEL     debug | info | warning | error
#   VS_SEED          default seed
#   VS_MODELS_DIR    overrides paths.models
#   VS_RUNS_DIR      overrides paths.runs
#   VS_LOGS_DIR      overrides paths.logs
#
#   VISUAL_SYNTHESIS_ROOT   project root, when it cannot be found from the package location

# API_KEY=change-me
# HF_TOKEN=hf_...
HF_HOME=data/cache/huggingface
