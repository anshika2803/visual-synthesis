{
  "_comment": [
    "Cluster override, layered on top of config/pipeline.json:",
    "  visual-synthesis run generate -c config/pipeline.json -c config/pipeline.hpc.json",
    "Only the keys that differ need to appear here."
  ],

  "logging": { "keep_runs": 100 },

  "run": { "mode": "full" },

  "download": {
    "models": ["sd-turbo", "sd-xl", "sd-3.5-medium", "sd-3.5-large", "sd-3.5-turbo"],
    "detectors": ["clip-h14"]
  },

  "generate": { "log_every": 25 },

  "nsfw": { "max_error_rate": 0.01 },

  "slurm": {
    "log_dir": "slurm/jobs",
    "gpu": { "partition": "MGPU-TC2" },
    "cpu": { "partition": "MGPU-TC2" },
    "set_env": {
      "HF_HOME": "data/cache/huggingface",
      "TOKENIZERS_PARALLELISM": "false",
      "OMP_NUM_THREADS": "8"
    }
  },

  "serve": { "host": "0.0.0.0" }
}
